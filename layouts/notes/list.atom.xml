{{- /* Atom 1.0 feed for Notes. Notes have no real title, so the first 80 characters of text stand in. */ -}}
{{- $pages := .Pages.ByDate.Reverse -}}
{{- $author := site.Params.author.name | default site.Title -}}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.Language.Locale | default "en" }}">
  <title>{{ .Title }} · {{ site.Title }}</title>
  <id>{{ .Permalink }}</id>
  <link rel="self" type="application/atom+xml" href="{{ with .OutputFormats.Get "atom" }}{{ .Permalink }}{{ end }}"/>
  <link rel="alternate" type="text/html" href="{{ .Permalink }}"/>
  <updated>{{ with $pages }}{{ (index . 0).Date.UTC.Format "2006-01-02T15:04:05Z" }}{{ else }}{{ now.UTC.Format "2006-01-02T15:04:05Z" }}{{ end }}</updated>
  <author><name>{{ $author }}</name></author>
  {{- range $pages }}
  <entry>
    <title>{{ .Plain | strings.TrimSpace | truncate 80 }}</title>
    <id>{{ .Permalink }}</id>
    <link rel="alternate" type="text/html" href="{{ .Permalink }}"/>
    <published>{{ .Date.UTC.Format "2006-01-02T15:04:05Z" }}</published>
    <updated>{{ .Lastmod.UTC.Format "2006-01-02T15:04:05Z" }}</updated>
    <content type="html">{{ .Content | transform.XMLEscape }}</content>
  </entry>
  {{- end }}
</feed>
